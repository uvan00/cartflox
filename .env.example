# ─── Obligatoire ────────────────────────────────────────────────────────────

# PostgreSQL 14 ou plus.
DATABASE_URL="postgresql://cartflox:motdepasse@127.0.0.1:5432/cartflox?schema=public"

# Adresse publique de l'application (sans barre finale). Sert aux liens dans
# les e-mails, aux pages de paiement et aux retours de connexion.
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secret des sessions (cookies signes). 32 octets au moins : `openssl rand -base64 32`.
BETTER_AUTH_SECRET=""

# Cle maitre du chiffrement des cles d'agregateurs. Deux formes acceptees :
#   - la valeur elle-meme (`openssl rand -base64 48`) ;
#   - une reference `file:/chemin/absolu` vers un fichier qui la contient (recommande en production :
#     le secret sort du .env, des vidages d'environnement et de toute copie du dossier).
# La perdre rend toutes les cles d'agregateurs illisibles : sauvegardez-la a part de la base.
KEY_VAULTS_SECRET="file:/etc/cartflox/master.key"

# Jeton des taches planifiees (voir README, section « Taches planifiees »).
CRON_SECRET=""

# ─── Courrier sortant (recus, alertes, confirmation d'adresse) ───────────────

MAIL_TRANSPORT="smtp"            # smtp ou brevo
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="support@votre-domaine.com"
MAIL_FROM_NAME="Cartflox"
MAIL_REPLY_TO="support@votre-domaine.com"
# Boite qui recoit les alertes et les messages de contact : DIFFERENTE de MAIL_FROM.
MAIL_INTERNAL=""
# Si MAIL_TRANSPORT=brevo :
BREVO_API_KEY=""

# ─── Facultatif ─────────────────────────────────────────────────────────────

# Marque affichee (nom, icone, logotype, site). Figees au build : reconstruire apres modification.
NEXT_PUBLIC_MARQUE="Cartflox"
NEXT_PUBLIC_MARQUE_TITRE="Cartflox"
# Site vitrine, si vous en avez un : le logo des pages de compte y mene et les liens
# Confidentialite / Securite (/privacy, /compliance) s'affichent. Vide = aucun.
NEXT_PUBLIC_MARQUE_SITE=""
NEXT_PUBLIC_MARQUE_ICONE="/cf/brand/cartflox-icon.svg"
NEXT_PUBLIC_MARQUE_MOT="/cf/brand/cartflox-wordmark.svg"
# Ville de la ligne de copyright des pages de compte. Vide = rien.
NEXT_PUBLIC_MARQUE_VILLE=""

# Numero WhatsApp du support de cette instance (chiffres avec indicatif, sans +), montre aux marchands et aux payeurs.
NEXT_PUBLIC_SUPPORT_WHATSAPP=""
SUPPORT_WHATSAPP=""
SUPPORT_NOM=""

# Hote court dedie a la page de paiement (ex. checkout.votre-domaine.com/<id>). Vide = /checkout/<id> sur l'hote principal.
CHECKOUT_HOST=""
CHECKOUT_PUBLIC_URL=""
# Hote qui sert les liens de paiement /pay/<slug>. Vide = NEXT_PUBLIC_APP_URL.
LIENS_PUBLIC_URL=""

# Cookie de session etendu a tous les sous-domaines (ex. .votre-domaine.com) et origines de confiance supplementaires (separees par des virgules).
SESSION_COOKIE_DOMAIN=""
TRUSTED_ORIGINS=""

# Redis : limitation de debit partagee entre plusieurs instances. Sans lui, limitation en memoire par instance.
REDIS_URL=""

# Fournisseur OpenID Connect externe (bouton « Continuer avec ... » sur la connexion).
# Adresse de retour a declarer chez le fournisseur : <NEXTAUTH_URL>/api/auth/callback/oidc
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
NEXT_PUBLIC_OIDC_ACTIF="0"
NEXT_PUBLIC_OIDC_NOM=""

# Support par chat (Chatwoot), lu a l'execution : rien n'est charge tant que le jeton est vide.
CHATWOOT_URL=""
CHATWOOT_WEBSITE_TOKEN=""

# Balises Google (mesure et Ads). Vides = rien n'est charge.
GOOGLE_TAG_ID=""
GOOGLE_ADS_ID=""
GOOGLE_ADS_CONVERSION_INSCRIPTION=""
GOOGLE_ADS_CONVERSION_ESPACE=""
GOOGLE_ADS_CONVERSION_PAIEMENT=""

# Stripe de l'instance (cartes) : le webhook /api/webhooks/stripe verifie la signature avec ces cles.
# A declarer chez Stripe sur <NEXTAUTH_URL>/api/webhooks/stripe (payment_intent.*, charge.refunded).
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Secret partage pour les appels internes entre vos propres services (en-tete x-internal-secret).
INTERNAL_SECRET=""

# Frais de passerelle estimes, en points de base, quand un lien de paiement les fait porter au client (300 = 3 %).
FRAIS_PASSERELLE_BPS="300"

# Relance WhatsApp d'un paiement en attente, par un pont HTTP compatible (POST /api/send?sessionId=...).
# Vide = le bouton de relance repond « pont non configure ».
WHATSAPP_BRIDGE_URL=""
WHATSAPP_SESSION_ID="default"
# Indicatif ajoute aux numeros enregistres sans indicatif (225 = Cote d'Ivoire).
WHATSAPP_INDICATIF_DEFAUT="225"

# Journal : debug, info, warn, error.
LOG_LEVEL="info"
